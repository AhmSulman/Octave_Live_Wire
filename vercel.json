{
  "version": 2,
  "builds": [
    {
      "src": "octave_live_wire/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "250mb" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "octave_live_wire/wsgi.py"
    }
  ]
}
