# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Required in production
SECRET_KEY=umycuzintvimucixyzqhejrgadsfdlkglkfdjjdfklgkldfsdagrjehqzyxicumivtnizucymubinuvicozpmybtcuztcrnymtvrbtzrcexrveum
DEBUG=False

# Comma-separated list of allowed hostnames
# e.g. myapp.vercel.app,myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Add your Vercel deployment URL and any custom domains
# e.g. https://myapp.vercel.app,https://myapp.com
CSRF_TRUSTED_ORIGINS=

# Set automatically by Vercel — do not change
# VERCEL=1
# VERCEL_ENV=production
