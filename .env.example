# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Required in production
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False

# Comma-separated list of allowed hostnames
# e.g. myapp.vercel.app,myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Add your Vercel deployment URL and any custom domains
# e.g. https://myapp.vercel.app,https://myapp.com
CSRF_TRUSTED_ORIGINS=

# Set automatically by Vercel — do not change
# VERCEL=1
# VERCEL_ENV=production

# Contact form (/contact/) — SMTP delivery. For Gmail, create an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
CONTACT_EMAIL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
